# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173
# Trust X-Forwarded-* from the reverse proxy (nginx) — set to 1 behind a proxy
TRUST_PROXY=0
LOG_LEVEL=info

# --- Database ------------------------------------------------------------
DATABASE_URL=postgres://cdms:cdms@localhost:5432/cdms
DATABASE_POOL_MAX=10

# --- Security (generate with: openssl rand -base64 48) --------------------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Set to 1 when served over HTTPS (production) so cookies are Secure
COOKIE_SECURE=0
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- File storage --------------------------------------------------------
STORAGE_DIR=./storage

# --- Seed ----------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@cdms.local
# Leave empty to generate a random password that is printed once
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=1
# Fixed password for demo accounts in development (ignored in production)
SEED_DEMO_PASSWORD=
