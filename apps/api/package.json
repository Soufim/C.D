{
  "name": "@cdms/api",
  "version": "0.1.0",
  "private": true,
  "description": "CDMS backend — NestJS modular monolith",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json -w --preserveWatchOutput & node --watch --watch-preserve-output dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/database/migrate.js",
    "db:migrate:dev": "nest build && node dist/database/migrate.js",
    "db:seed": "node dist/database/seed.js",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@cdms/contracts": "^0.1.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "~5.9.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
