# Copy to the repository root as .env (never commit it). Generate secrets with:
#   openssl rand -base64 48
# Note: '#' starts a comment in .env files — avoid it inside unquoted values.
CDMS_VERSION=0.1.0
REGISTRY=cdms
PUBLIC_ORIGIN=https://cdms.example.gov.eg
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

POSTGRES_USER=cdms
POSTGRES_DB=cdms
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
COOKIE_SECURE=1
LOG_LEVEL=info

# First administrator (created only if it does not exist). Leave the password empty to
# have a random one printed once in the "migrate" container logs.
SEED_ADMIN_EMAIL=admin@cdms.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=0

# Backups (scripts/backup.sh)
BACKUP_DIR=/var/backups/cdms
BACKUP_RETENTION_DAYS=30
